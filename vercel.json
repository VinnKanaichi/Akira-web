{
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        { "type": "header", "key": "x-requested-with", "value": "com\\.web2apk\\..*" }
      ],
      "destination": "/blocked.html"
    },
    {
      "source": "/(.*)",
      "has": [
        { "type": "header", "key": "user-agent", "value": "(?i).*(axios|node-fetch|undici|curl|wget|python|okhttp|scrapy|httrack|java|go-http-client).*" }
      ],
      "destination": "/blocked.html"
    }
  ]
}
